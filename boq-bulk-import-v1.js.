  /* =========================================================
     HELPERS
  ========================================================= */

  function norm(value) {
    return String(
      value == null
        ? ""
        : value
    ).trim();
  }


  function num(value) {
    if (
      typeof value === "number"
    ) {
      return value;
    }

    const result =
      Number(
        norm(value)
          .replace(/,/g, "")
      );

    return Number.isFinite(result)
      ? result
      : NaN;
  }


  function escapeSafe(value) {
    if (
      typeof window.escapeHtml ===
      "function"
    ) {
      return window.escapeHtml(value);
    }

    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  function keyOf(row) {
    return [
      row.project,
      row.tower,
      row.floor,
      row.itemNo
    ]
      .map(function (value) {
        return norm(value)
          .toLowerCase();
      })
      .join("||");
  }


  /* =========================================================
     MASTER DATA VALIDATION
  ========================================================= */

  function getMasterDataSafe() {
    if (
      typeof masterData !==
      "undefined" &&
      masterData
    ) {
      return masterData;
    }

    return {
      projects: [],
      towers: [],
      floors: []
    };
  }


  function projectExists(project) {
    const md =
      getMasterDataSafe();

    return (
      md.projects || []
    ).some(function (row) {
      return (
        norm(
          row["Project Name"]
        ) === project
      );
    });
  }


  function towerExists(
    project,
    tower
  ) {
    const md =
      getMasterDataSafe();

    return (
      md.towers || []
    ).some(function (row) {
      return (
        norm(
          row["Project"]
        ) === project &&
        norm(
          row["Tower / Block"]
        ) === tower
      );
    });
  }


  function floorExists(
    project,
    tower,
    floor
  ) {
    if (
      floor ===
      "Overall / All Floors"
    ) {
      return true;
    }

    const md =
      getMasterDataSafe();

    return (
      md.floors || []
    ).some(function (row) {

      const rowProject =
        norm(
          row["Project"]
        );

      return (
        norm(
          row["Tower / Block"]
        ) === tower &&
        (
          !rowProject ||
          rowProject === project
        ) &&
        norm(
          row["Floor"]
        ) === floor
      );
    });
  }


  /* =========================================================
     ROW VALIDATION
  ========================================================= */

  function validateRows(rows) {
    const seen =
      new Set();

    return rows.map(
      function (row, index) {

        const errors = [];

        const requiredMap = [
          ["BOQ Code", "itemNo"],
          ["Description", "description"],
          ["Unit", "unit"],
          ["Qty", "contractQty"],
          ["Rate", "rate"],
          ["Project", "project"],
          ["Tower/Block", "tower"],
          ["Floor/Area", "floor"],
          ["Category", "workPackage"]
        ];

        requiredMap.forEach(
          function (item) {

            const header =
              item[0];

            const property =
              item[1];

            if (
              !norm(
                row[property]
              )
            ) {
              errors.push(
                header +
                " is required"
              );
            }
          }
        );


        const qty =
          num(
            row.contractQty
          );

        const rate =
          num(
            row.rate
          );


        if (
          !Number.isFinite(qty) ||
          qty < 0
        ) {
          errors.push(
            "Qty must be a non-negative number"
          );
        }


        if (
          !Number.isFinite(rate) ||
          rate < 0
        ) {
          errors.push(
            "Rate must be a non-negative number"
          );
        }


        if (
          row.project &&
          !projectExists(
            row.project
          )
        ) {
          errors.push(
            "Invalid Project"
          );
        }


        if (
          row.project &&
          row.tower &&
          !towerExists(
            row.project,
            row.tower
          )
        ) {
          errors.push(
            "Tower/Block does not belong to Project"
          );
        }


        if (
          row.project &&
          row.tower &&
          row.floor &&
          !floorExists(
            row.project,
            row.tower,
            row.floor
          )
        ) {
          errors.push(
            "Invalid Floor/Area"
          );
        }


        const key =
          keyOf(row);


        if (
          seen.has(key)
        ) {
          errors.push(
            "Duplicate within Excel file"
          );
        }


        seen.add(key);


        row._row =
          index + 2;

        row._errors =
          errors;


        row.contractQty =
          Number.isFinite(qty)
            ? qty
            : 0;


        row.rate =
          Number.isFinite(rate)
            ? rate
            : 0;


        row.amount =
          Math.round(
            row.contractQty *
            row.rate *
            100
          ) / 100;


        row.contractor =
          norm(
            row.contractor
          ) ||
          "Not Assigned";


        row.status =
          "Active";


        row.remarks =
          "Imported from BOQ Bulk Excel";


        return row;
      }
    );
  }


  /* =========================================================
     READ EXCEL
  ========================================================= */

  function readWorkbook(file) {
    return new Promise(
      function (
        resolve,
        reject
      ) {

        const reader =
          new FileReader();


        reader.onload =
          function (event) {

            try {

              const workbook =
                XLSX.read(
                  event.target.result,
                  {
                    type: "array"
                  }
                );


              const firstSheet =
                workbook.Sheets[
                  workbook
                    .SheetNames[0]
                ];


              const data =
                XLSX.utils
                  .sheet_to_json(
                    firstSheet,
                    {
                      defval: ""
                    }
                  );


              resolve(data);

            } catch (error) {

              reject(error);

            }
          };


        reader.onerror =
          function () {
            reject(
              new Error(
                "Unable to read Excel file."
              )
            );
          };


        reader.readAsArrayBuffer(
          file
        );
      }
    );
  }


  function mapExcelRows(data) {
    return data.map(
      function (row) {

        return {

          itemNo:
            norm(
              row["BOQ Code"]
            ),

          description:
            norm(
              row["Description"]
            ),

          unit:
            norm(
              row["Unit"]
            ),

          contractQty:
            row["Qty"],

          rate:
            row["Rate"],

          project:
            norm(
              row["Project"]
            ),

          tower:
            norm(
              row["Tower/Block"]
            ),

          floor:
            norm(
              row["Floor/Area"]
            ),

          workPackage:
            norm(
              row["Category"]
            ),

          contractor:
            norm(
              row["Contractor"] || ""
            )

        };
      }
    );
  }


