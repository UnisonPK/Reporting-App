  function findAddBOQButton() {
    const page =
      document.getElementById("boqCostPage");

    if (!page) return null;

    const buttons =
      page.querySelectorAll("button");

    for (let i = 0; i < buttons.length; i++) {
      const text =
        String(buttons[i].textContent || "")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();

      if (
        text.indexOf("add boq item") !== -1
      ) {
        return buttons[i];
      }
    }

    return null;
  }


