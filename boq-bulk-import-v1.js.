  /* =========================================================
     PREVIEW
  ========================================================= */

  window.previewBOQExcel =
    async function () {

      const fileInput =
        document.getElementById(
          "boqBulkFile"
        );


      const status =
        document.getElementById(
          "boqBulkStatus"
        );


      if (
        !fileInput ||
        !fileInput.files ||
        !fileInput.files[0]
      ) {

        status.style.color =
          "#dc2626";

        status.textContent =
          "Select an Excel file first.";

        return;
      }


      const file =
        fileInput.files[0];


      try {

        status.style.color =
          "#475569";


        status.textContent =
          "Reading and validating Excel file...";


        await injectSheetJs();


        const raw =
          await readWorkbook(
            file
          );


        if (!raw.length) {
          throw new Error(
            "The first worksheet contains no data."
          );
        }


        const headers =
          Object.keys(
            raw[0] || {}
          );


        const missing =
          REQUIRED_HEADERS.filter(
            function (header) {
              return (
                headers.indexOf(
                  header
                ) === -1
              );
            }
          );


        if (missing.length) {
          throw new Error(
            "Missing required column(s): " +
            missing.join(", ")
          );
        }


        importRows =
          validateRows(
            mapExcelRows(
              raw
            )
          );


        renderPreview();


        const valid =
          importRows.filter(
            function (row) {
              return (
                !row._errors.length
              );
            }
          ).length;


        const invalid =
          importRows.length -
          valid;


        status.style.color =
          invalid
            ? "#b45309"
            : "#166534";


        status.textContent =
          invalid

            ? valid +
              " valid row(s), " +
              invalid +
              " row(s) need correction."

            : valid +
              " row(s) validated and ready to import.";


        document.getElementById(
          "boqBulkImportNow"
        ).disabled =
          valid === 0;


      } catch (error) {

        importRows = [];


        status.style.color =
          "#dc2626";


        status.textContent =
          error.message;


        document.getElementById(
          "boqBulkImportNow"
        ).disabled =
          true;
      }
    };


  /* =========================================================
     PREVIEW TABLE
  ========================================================= */

  function renderPreview() {

    const valid =
      importRows.filter(
        function (row) {
          return (
            !row._errors.length
          );
        }
      ).length;


    const invalid =
      importRows.length -
      valid;


    const total =
      importRows.reduce(
        function (
          sum,
          row
        ) {

          return (
            sum +
            (
              row._errors.length
                ? 0
                : row.amount
            )
          );

        },
        0
      );


    document.getElementById(
      "boqBulkSummary"
    ).innerHTML =

      '<span class="boq-import-chip">' +
      'Rows: ' +
      importRows.length +
      '</span>' +

      '<span class="boq-import-chip">' +
      'Valid: ' +
      valid +
      '</span>' +

      '<span class="boq-import-chip">' +
      'Errors: ' +
      invalid +
      '</span>' +

      '<span class="boq-import-chip">' +
      'Valid Amount: PKR ' +
      total.toLocaleString(
        undefined,
        {
          maximumFractionDigits: 2
        }
      ) +
      '</span>';


    let html = `
      <div class="boq-import-table-wrap">

        <table class="boq-import-table">

          <thead>
            <tr>
              <th>Row</th>
              <th>BOQ Code</th>
              <th>Description</th>
              <th>Unit</th>
              <th>Qty</th>
              <th>Rate</th>
              <th>Amount</th>
              <th>Project</th>
              <th>Tower/Block</th>
              <th>Floor/Area</th>
              <th>Category</th>
              <th>Validation</th>
            </tr>
          </thead>

          <tbody>
    `;


    importRows.forEach(
      function (row) {

        html +=
          '<tr class="' +
          (
            row._errors.length
              ? "boq-import-error"
              : "boq-import-valid"
          ) +
          '">' +

          '<td>' +
          row._row +
          '</td>' +

          '<td><b>' +
          escapeSafe(
            row.itemNo
          ) +
          '</b></td>' +

          '<td>' +
          escapeSafe(
            row.description
          ) +
          '</td>' +

          '<td>' +
          escapeSafe(
            row.unit
          ) +
          '</td>' +

          '<td>' +
          row.contractQty +
          '</td>' +

          '<td>' +
          row.rate +
          '</td>' +

          '<td>' +
          row.amount.toLocaleString() +
          '</td>' +

          '<td>' +
          escapeSafe(
            row.project
          ) +
          '</td>' +

          '<td>' +
          escapeSafe(
            row.tower
          ) +
          '</td>' +

          '<td>' +
          escapeSafe(
            row.floor
          ) +
          '</td>' +

          '<td>' +
          escapeSafe(
            row.workPackage
          ) +
          '</td>' +

          '<td>' +
          (
            row._errors.length
              ? escapeSafe(
                  row._errors.join(
                    "; "
                  )
                )
              : "Ready"
          ) +
          '</td>' +

          '</tr>';
      }
    );


    html += `
          </tbody>

        </table>

      </div>
    `;


    document.getElementById(
      "boqBulkPreview"
    ).innerHTML =
      html;
  }


  /* =========================================================
     IMPORT
  ========================================================= */

  window.commitBOQBulkImport =
    function () {

      const validRows =
        importRows
          .filter(
            function (row) {
              return (
                !row._errors.length
              );
            }
          )
          .map(
            function (row) {

              return {

                itemNo:
                  row.itemNo,

                description:
                  row.description,

                unit:
                  row.unit,

                contractQty:
                  row.contractQty,

                rate:
                  row.rate,

                project:
                  row.project,

                tower:
                  row.tower,

                floor:
                  row.floor,

                workPackage:
                  row.workPackage,

                contractor:
                  row.contractor,

                status:
                  "Active",

                certifiedQty:
                  0,

                paidAmount:
                  0,

                variationAmount:
                  0,

                remarks:
                  row.remarks

              };
            }
          );


      if (!validRows.length) {
        return;
      }


      const button =
        document.getElementById(
          "boqBulkImportNow"
        );


      const status =
        document.getElementById(
          "boqBulkStatus"
        );


      button.disabled =
        true;


      status.style.color =
        "#475569";


      status.textContent =
        "Importing validated BOQ rows...";


      if (
        !window.LCRG_API ||
        typeof window.LCRG_API.call !==
        "function"
      ) {

        button.disabled =
          false;


        status.style.color =
          "#dc2626";


        status.textContent =
          "Reporting App API is not available.";


        return;
      }


      window.LCRG_API
        .call(
          "bulkImportBOQ",
          {
            rows:
              validRows
          }
        )

        .then(
          function (result) {

            status.style.color =
              result.skipped > 0
                ? "#b45309"
                : "#166534";


            status.textContent =
              "Import complete: " +
              result.imported +
              " imported, " +
              result.skipped +
              " duplicate/skipped.";


            button.disabled =
              false;


            if (
              typeof loadBOQCost ===
              "function"
            ) {
              loadBOQCost();
            }

          }
        )

        .catch(
          function (error) {

            button.disabled =
              false;


            status.style.color =
              "#dc2626";


            status.textContent =
              error.message;

          }
        );
    };


  /* =========================================================
     INITIALIZATION
  ========================================================= */

  function boot() {
    injectUi();

    /*
      BOQ screen may be inserted/updated after the external script
      initially runs, so retry button injection a few times.
    */

    let attempts = 0;

    const timer =
      setInterval(
        function () {

          injectBulkImportButton();

          attempts++;

          if (
            document.getElementById(
              "boqBulkImportButton"
            ) ||
            attempts >= 20
          ) {
            clearInterval(timer);
          }

        },
        500
      );
  }


  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      boot
    );

  } else {

    boot();

  }

})();
